{
  "name": "@nerima-games/mc-noise",
  "version": "0.5.0",
  "type": "module",
  "description": "Seeded deterministic noise, portable Minecraft density functions, and sampling primitives. The seed -> value interface is a versioned contract.",
  "homepage": "https://github.com/nerima-games/mc-noise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-noise.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-noise/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "noise",
    "perlin",
    "value-noise",
    "fbm"
  ],
  "scripts": {
    "bench": "tsx scripts/bench-noise.ts",
    "bench:density": "tsx scripts/bench-density-function.ts",
    "bench:density:decoded": "tsx scripts/bench-decoded-old-blended.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test && ast-grep test --config .ast-grep/sgconfig.yml && ast-grep scan",
    "lint:fix": "oxlint --fix src scripts test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "verify:consumer-migration": "node scripts/generate-consumer-migration.mjs --check",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm verify:consumer-migration"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.9.0",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/vitest": "4.0.5",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "knip": "6.42.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
