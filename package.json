{
  "name": "@nerima-games/mc-noise",
  "version": "0.1.0",
  "type": "module",
  "description": "Seeded deterministic noise for the nerima-games Minecraft-clone rebuild: PRNG, Perlin kernels, octave/fBm composition. The seed -> value interface is a frozen contract.",
  "homepage": "https://github.com/nerima-games/mc-noise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-noise.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-noise/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "domain",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "noise",
    "perlin",
    "fbm"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "oxlint --deny-warnings index.ts domain scripts test",
    "lint:fix": "oxlint --fix index.ts domain scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:deps": "tsx scripts/check-dependency-whitelist.ts",
    "bench": "tsx scripts/bench-noise.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm test"
  },
  "dependencies": {
    "effect": "^3.20.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.25.1",
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^3.2.4",
    "oxlint": "^0.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
