{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // *** FOLLOW-UP FIX (2026-08-01): this file used to be named `oxlint.json`
  // (no leading dot) and was NEVER auto-discovered by oxlint 1.75.0. ***
  // Verified empirically: with the old filename, `oxlint --print-config` from
  // the repository root (no `-c` flag, i.e. exactly how `pnpm lint` invokes
  // it) returned oxlint's bare built-in defaults, not this file's rules —
  // `oxlint --help` documents the config flag's default value as
  // `./.oxlintrc.json`, not `oxlint.json`. In other words: every custom rule
  // in this file — including the pre-existing `effect` default-import ban and
  // the `no-restricted-imports` Tier1 dependency rule below — was silently
  // never enforced by `pnpm lint` or CI. This predated the org-standard
  // migration and was not specific to mc-noise; every repository using the
  // `oxlint.json` filename convention used by older package guidance was
  // affected.
  //
  // Renaming to `.oxlintrc.json` alone was not sufficient. Two more fixes were
  // required, verified empirically against the Nix-provided `oxlint@1.75.0`, before
  // `oxlint --print-config` would actually load and print this file's custom
  // rules: (1) `no-restricted-imports` needs the nested
  // `["error", {"paths": [...], "patterns": [...]}]` options-object form — a
  // bare `{"name"/"regex"}` object passed as a second array element (the
  // shape this file previously used) is silently ignored; and (2) a block of
  // `eslint`-plugin style/formatting rules this file used to set (`indent`,
  // `comma-dangle`, `array-bracket-spacing`, `no-tabs`, etc.) no longer exist
  // in oxlint 1.75.0 (oxlint moved formatting out of the linter into a
  // separate, still-experimental formatter) and caused a hard config-parse
  // failure — with them present, `oxlint --print-config` refused to parse at
  // all and `pnpm lint` silently fell back to bare built-in defaults, so
  // removing them was not optional: no custom rule, including
  // `no-restricted-imports`, could load while they remained. They have been
  // removed below; the `style` category default (`"style": "warn"`) still
  // covers whichever of those concerns oxlint's own built-in style rules
  // still express.
  //
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // NOTE on the `Date.now()` ban:
  // This repository keeps time sources out of deterministic noise logic as a source
  // policy. The current oxlint configuration does not enforce that syntax rule;
  // the repository audit and review contract remain the enforcement surface.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "7.0"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    // NOTE: this block used to also set ~29 `eslint`-plugin formatting rules
    // (`array-bracket-spacing`, `block-spacing`, `brace-style`, `camelcase`,
    // `comma-dangle`, `comma-spacing`, `comma-style`, `computed-property-spacing`,
    // `eol-last`, `func-call-spacing`, `indent`, `key-spacing`, `keyword-spacing`,
    // `linebreak-style`, `lines-between-class-members`, `no-mixed-spaces-and-tabs`,
    // `no-new-object`, `no-tabs`, `no-trailing-spaces`, `no-whitespace-before-property`,
    // `object-curly-spacing`, `one-var`, `operator-linebreak`, `padded-blocks`,
    // `quote-props`, `semi-spacing`, `space-before-blocks`, `space-infix-ops`,
    // `space-unary-ops`, `spaced-comment`). None of these exist as rule names
    // in oxlint 1.75.0 (oxlint moved formatting out of the linter into a
    // separate, still-experimental formatter). Verified empirically: with any
    // of them present, `oxlint --print-config` and `oxlint` both hard-fail to
    // parse this config file ("Rule 'X' not found in plugin 'eslint'") and
    // fall back to bare built-in defaults — meaning no custom rule in this
    // file, including `no-restricted-imports` below, was actually being
    // loaded. They have been removed; formatting is no longer this
    // repository's concern via oxlint (there is still no prettier, no biome,
    // no .editorconfig — see the top-of-file note). The `style` category
    // default (`"style": "warn"`) still covers whichever style rules oxlint
    // 1.75.0 still implements under that category.
    "no-array-method-this-argument": "warn",
    // `NoiseSeed(...)` is an `effect` `Brand.refined` constructor, called as a
    // plain function per the Effect ecosystem convention (Schema.Struct(...),
    // Context.Tag(...), etc.) — not a `class`, so `new NoiseSeed(...)` is not
    // an option. Verified empirically (oxlint 1.75.0): `capIsNewExceptions`
    // is the rule's own documented escape hatch for exactly this shape (see
    // the rule's own warning text: "add it to the exceptions list"), so this
    // is a scoped rule option, not a suppression — every other capitalized
    // call in src/ still warns.
    "new-cap": ["warn", { "capIsNewExceptions": ["NoiseSeed"] }],
    // Verified empirically (oxlint 1.75.0) across parameters, type-literal
    // properties, and class fields: `exceptions` is respected in every
    // context, so this is a scoped rule option, not a suppression — any
    // other single-character identifier in src/ still warns. The list is
    // exactly this domain's coordinate/math vocabulary and nothing else:
    // x/y/z (spatial coordinates — `NoisePoint2D.x`/`.z` and `NoiseFn2D`/
    // `NoiseFn3D` are the public API, so renaming them would be a breaking
    // change, not a style fix), t (interpolation parameter in lerp/easing),
    // a/b (lerp's two endpoints, matching `lerp(a, b, t)` convention), and
    // h/u/v (hash and gradient components, matching Ken Perlin's own
    // reference implementation naming for these exact roles).
    "id-length": ["warn", { "exceptions": ["a", "b", "h", "t", "u", "v", "x", "y", "z"] }],
    // Verified against every real violation in src/ (none exceeds 4): this
    // domain's core sampler functions take a noise/seed source, 2-3
    // coordinates, and a config object — four conceptually atomic
    // parameters, not a struct pretending to be one. Bundling the
    // coordinates into an options object to hit the default max of 3 would
    // add an allocation and an indirection to the hottest path in world
    // generation for no behavioural benefit (see the PERFORMANCE EXCEPTION
    // note in octaves.ts). A function needing a 5th parameter still warns.
    "max-params": ["warn", { "max": 4 }],
    // PERFORMANCE / CORRECTNESS EXCEPTION — see docs/design-notes.md.
    // The seed hash (mulberry32) and the permutation-table index are defined in
    // terms of uint32 wrapping arithmetic: `>>> 0`, `^`, `| 1`, `& 255`. Those
    // are not a micro-optimisation, they are the specification of the function.
    // Rewriting them with arithmetic operators would change the values the seed
    // produces, and the seed -> value mapping is a frozen contract (docs/versioning.md §5).
    "no-bitwise": "off",

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Declared for intent and for the day oxlint implements it; inert in 0.12
    // (see the NOTE at the top of this file).
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    // NOTE: the options must be a single nested object,
    // `["error", {"paths": [...], "patterns": [...]}]` — a bare
    // `{"name"/"regex"}` object passed as its own array element (what this
    // file previously had for the `effect` entry) is silently not registered.
    // Within `patterns`, use `group` (glob, with `!` negation for the
    // mc-kernel exemption), not `regex`. The dependency guidance's Tier1 example
    // uses `regex`, but oxlint 1.75.0 (the Nix-provided version)
    // silently does not match against a `regex`-only pattern — verified
    // empirically: it produces zero diagnostics for a matching import.
    // IMPORTANT, also verified empirically: putting `regex` and `group` on
    // the *same* pattern entry does not "fail open" to the working `group`
    // key — it silently disables matching entirely, same as `regex` alone.
    // So `regex` must not be present here at all, not even alongside `group`
    // as a defensive fallback; `group` must be the pattern's only match key.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        "patterns": [
          {
            "group": ["@nerima-games/**", "!@nerima-games/mc-kernel", "!@nerima-games/mc-kernel/**"],
            "message": "mc-noise is Tier1 (DEPENDENCY_POLICY.md §1); only the listed packages may be imported."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  // Scoped strictness: src/ (the shipped library) is fully strict — every
  // category default and every rule above stays "warn"/"error" there, and a
  // violation must be fixed in source, never suppressed. test/** and
  // scripts/** are relaxed below, each for its own reason verified against
  // this repository's actual code, not a blanket "tests are exempt" policy:
  //
  //  - test/**: assertions are written against literal expected values by
  //    design (`expect(x).toBe(0.42)`), so `no-magic-numbers` fires on
  //    correctness-bearing numbers whose whole point is to be a literal, not
  //    a named constant. `id-length`, `sort-keys`, `sort-imports`,
  //    `capitalized-comments`, `max-params`/`max-statements` flag the terse,
  //    table-driven, high-arity style normal for test fixtures and don't
  //    track a real defect.
  //  - scripts/**: dev-only benchmark tooling (bench-noise.ts,
  //    bench-harness.ts), never shipped, never imported by src/. `no-console`
  //    would ban the console output that is the script's entire purpose;
  //    `no-ternary`/`no-nested-ternary`, `no-undefined`, and the same
  //    literal-heavy rules as test/** fire on ordinary CLI-reporting code.
  //
  // Verified empirically (oxlint 1.75.0): `overrides[].files` glob-matches
  // against paths relative to the config file and layers rules on top of the
  // base `rules` block above rather than replacing it, so anything not
  // listed per-override (e.g. `no-eval`, the `no-restricted-imports` Tier1
  // dependency rule) still applies inside test/ and scripts/ too.
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "capitalized-comments": "off",
        "max-params": "off",
        "max-statements": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "capitalized-comments": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-console": "off",
        "no-ternary": "off",
        "no-nested-ternary": "off",
        "no-undefined": "off",
        "new-cap": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
