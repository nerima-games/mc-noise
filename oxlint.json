{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // *** THIS FILE IS NOT CURRENTLY BEING AUTO-DISCOVERED BY oxlint 1.76.0. ***
  // Verified empirically (2026-08-01) with the pinned `oxlint@1.76.0`: running
  // `oxlint --print-config` from the repository root (no `-c` flag, i.e. exactly
  // how `pnpm lint` invokes it) returns oxlint's bare built-in defaults, not this
  // file's rules — `oxlint --help` documents the config flag's default value as
  // `./.oxlintrc.json`, not `oxlint.json`. Renaming this file to `.oxlintrc.json`
  // does make it load, but it then fails to parse for two further reasons: (1)
  // `ignore` (below) is not a recognised key in the current schema — it wants
  // `ignorePatterns` — and (2) a number of the style/formatting rules this file
  // sets (`indent`, `comma-dangle`, `array-bracket-spacing`, `no-tabs`, etc.) no
  // longer exist as `eslint`-plugin rules in oxlint 1.76.0 (oxlint moved
  // formatting out of the linter). In other words: the custom rules in this file
  // — including the pre-existing `effect` default-import ban and the
  // `no-restricted-imports` Tier1 dependency rule added below — are not
  // currently enforced by `pnpm lint` or CI. This predates this migration and
  // is not specific to mc-noise; every repository using this same `oxlint.json`
  // filename convention (see PACKAGE_STANDARD.md / DEPENDENCY_POLICY.md
  // examples, which all show `oxlint.json`) is affected. Fixing it requires a
  // rule-by-rule audit against the current oxlint version, which is out of
  // scope for this migration PR; see the PR description for the full report.
  //
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // NOTE on the `Date.now()` ban (see README 現状):
  // oxlint 0.12 does not implement `no-restricted-syntax` or `no-restricted-properties`,
  // and while `no-restricted-globals` is listed by `oxlint --rules` it is not implemented
  // either (no checkmark). Verified empirically against oxlint 0.12.0: a file containing
  // `Date.now()` produces 0 diagnostics under all three rules. `scripts/check-dependency-whitelist.ts`,
  // which used to enforce this, has been removed org-wide (PACKAGE_STANDARD.md /
  // DEPENDENCY_POLICY.md): the cross-repo dependency check it also performed is now
  // handled by the `no-restricted-imports` rule below, and this repository does not
  // currently have a replacement for the time-source ban (each repository's own
  // discretion per DEPENDENCY_POLICY.md §5). When oxlint gains `no-restricted-syntax`,
  // add the ban here.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "5.9"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    "array-bracket-spacing": "warn",
    "block-spacing": "warn",
    "brace-style": ["warn", "1tbs", { "allowSingleLine": true }],
    "camelcase": "warn",
    "comma-dangle": ["warn", "always-multiline"],
    "comma-spacing": "warn",
    "comma-style": "warn",
    "computed-property-spacing": "warn",
    "eol-last": "warn",
    "func-call-spacing": "warn",
    "indent": "off",
    "key-spacing": "warn",
    "keyword-spacing": "warn",
    "linebreak-style": ["warn", "unix"],
    "lines-between-class-members": "warn",
    "no-array-method-this-argument": "warn",
    // PERFORMANCE / CORRECTNESS EXCEPTION — see docs/design-notes.md.
    // The seed hash (mulberry32) and the permutation-table index are defined in
    // terms of uint32 wrapping arithmetic: `>>> 0`, `^`, `| 1`, `& 255`. Those
    // are not a micro-optimisation, they are the specification of the function.
    // Rewriting them with arithmetic operators would change the values the seed
    // produces, and the seed -> value mapping is a frozen contract (plan.md §3.2).
    "no-bitwise": "off",
    "no-mixed-spaces-and-tabs": "error",
    "no-new-object": "warn",
    "no-tabs": "error",
    "no-trailing-spaces": "warn",
    "no-whitespace-before-property": "warn",
    "object-curly-spacing": ["warn", "always"],
    "one-var": ["warn", "never"],
    "operator-linebreak": "warn",
    "padded-blocks": ["warn", "never"],
    "quote-props": ["warn", "as-needed"],
    "semi-spacing": "warn",
    "space-before-blocks": "warn",
    "space-infix-ops": "warn",
    "space-unary-ops": "warn",
    "spaced-comment": "warn",

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Declared for intent and for the day oxlint implements it; inert in 0.12
    // (see the NOTE at the top of this file).
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    "no-restricted-imports": [
      "warn",
      {
        "name": "effect",
        "message": "Please use named imports from 'effect' package",
        "importNames": ["default"]
      },
      {
        "patterns": [
          {
            // NOTE: DEPENDENCY_POLICY.md's Tier1 example uses a `regex` key here,
            // but oxlint 1.76.0 (this repository's pinned version) silently does
            // not match against `regex` in `no-restricted-imports` patterns —
            // verified empirically: a `regex`-only pattern produces zero
            // diagnostics for a matching import. `group` (glob, with `!` negation
            // for the mc-kernel exemption) is the form that actually fires on
            // this oxlint version.
            "group": ["@nerima-games/*", "!@nerima-games/mc-kernel"],
            "message": "mc-noise is a Tier1 library (DEPENDENCY_POLICY.md) and must not depend on any other @nerima-games/* package. mc-kernel is universally importable and exempt."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
